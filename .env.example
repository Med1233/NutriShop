# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=<change-to-strong-password>
POSTGRES_DB=appdb
DATABASE_URL=postgresql://admin:<password>@postgres:5432/appdb

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=<generate-random-64-char-string>
JWT_REFRESH_SECRET=<generate-another-random-64-char-string>

# Google OAuth (optional — app works without it)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# URLs
FRONTEND_URL=http://localhost:3000

# Default admin account (seeded on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-password-here>
ADMIN_NAME=Admin

# AI Chatbot (get key from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
